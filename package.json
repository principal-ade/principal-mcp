{
  "name": "@principal-ai/principal-mcp",
  "version": "0.0.8",
  "description": "Standalone MCP server bundle for PrincipleMD - run with npx or bunx",
  "main": "dist/mcp-server.js",
  "bin": {
    "principal-mcp": "dist/mcp-server.js"
  },
  "scripts": {
    "build": "bun run scripts/bundle.ts",
    "clean": "rm -rf dist",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "prepublishOnly": "bun run clean && bun run build && bun test"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-org/principle-md.git",
    "directory": "principal-mcp"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "principle",
    "mcp",
    "agent",
    "bundle"
  ],
  "license": "MIT",
  "dependencies": {
    "@backlog-md/core": "^0.3.13",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@opentelemetry/api": "^1.9.0",
    "globby": "^16.1.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.3.3",
    "esbuild": "^0.27.3",
    "eslint": "^10.0.2",
    "globals": "^17.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "packageManager": "bun@1.1.20"
}
